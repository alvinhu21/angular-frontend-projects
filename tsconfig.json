/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./", // This is the missing piece
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler", // Recommended when using "module": "preserve" or "ESNext"
    "paths": {
      "shared-lib": [
        "./dist/shared-lib"
      ],
      "shared-lib/*": [
        "./dist/shared-lib/*"
      ]
    },
    "importHelpers": true,
    "target": "ES2022",
    "module": "ESNext" // Changing "preserve" to "ESNext" is often more stable for Angular workspaces
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/shared-lib/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared-lib/tsconfig.spec.json"
    },
    {
      "path": "./projects/card-games/tsconfig.app.json"
    },
    {
      "path": "./projects/card-games/tsconfig.spec.json"
    },
    {
      "path": "./projects/yahoo-finance/tsconfig.app.json"
    },
    {
      "path": "./projects/yahoo-finance/tsconfig.spec.json"
    },
    {
      "path": "./projects/pokemon-webapp/tsconfig.app.json"
    },
    {
      "path": "./projects/pokemon-webapp/tsconfig.spec.json"
    }
  ]
}
